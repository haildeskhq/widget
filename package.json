{
  "name": "@haildesk/widget",
  "version": "1.0.7",
  "description": "Haildesk chat widget",
  "keywords": [
    "haildesk",
    "chat",
    "widget",
    "support",
    "customer support",
    "live chat",
    "helpdesk",
    "ai support"
  ],
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.js",
  "types": "./dist/npm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/npm/index.js",
      "require": "./dist/npm/index.cjs",
      "types": "./dist/npm/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CUSTOM_STYLES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.npm.ts",
    "build:cdn": "vite build",
    "build:npm": "vite build --config vite.config.npm.ts && tsc -p tsconfig.build.json",
    "release": "npm run build:npm && npm publish --access public",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "socket.io-client": "^4.7.5",
    "typescript": "^5.4.0",
    "vite": "^5.3.1"
  }
}
